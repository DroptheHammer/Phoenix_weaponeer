{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoenix Weaponeer",
  "version": "0.2.1",
  "identifier": "com.phoenix.weaponeer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phoenix Weaponeer",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost"
        ],
        "script-src": [
          "'self'"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https://tile.openstreetmap.org"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'none'"
        ],
        "frame-ancestors": [
          "'none'"
        ]
      },
      "devCsp": {
        "default-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost"
        ],
        "script-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https://tile.openstreetmap.org"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "ws://localhost:1420",
          "http://localhost:1420"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'none'"
        ],
        "frame-ancestors": [
          "'none'"
        ]
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
